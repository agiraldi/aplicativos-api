# Porta da API local
PORT=5000

# String de conexão do MongoDB (Atlas ou local)
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/aplicativos_db?retryWrites=true&w=majority

# Origem permitida no CORS (Frontend)
CLIENT_URL=http://localhost:3000,http://127.0.0.1:5500,https://aplicativos-frontend.vercel.app

# Ambiente de execução
NODE_ENV=development
